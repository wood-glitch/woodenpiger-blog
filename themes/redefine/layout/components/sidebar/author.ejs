<div class="author flex flex-row items-center justify-center gap-1.5 my-2.5 mx-0 flex-nowrap">
    <div class="name"><%= theme.info.author || config.author %></div>
    <% if (theme.hasOwnProperty('articles') && theme.articles.author_label.enable === true) { %>
        <div class="label inline-flex items-center shrink-0"><%- getAuthorLabel(site.posts.length, theme.articles.author_label.auto, theme.articles.author_label.list) %></div>
    <% } %>
</div>